# MCProxy Adapter — stdio-to-HTTP bridge
#
# Hardening is applied at the *runtime* level (quadlet / compose):
#   NoNewPrivileges, DropCapability=ALL, PrivateTmp, bridge networking.
# This image runs as a non-root user; subprocess spawning (npx, uvx,
# node, python) is permitted via the runtime's capability allow-list.
#
# Build:
#   docker build -f Dockerfile.adapter -t localhost/mcp-adapter:latest .

FROM python:3.11-slim

WORKDIR /app

# Pin venv Python interpreter — fail-fast if missing; no PATH fallback
ARG VENV_PYTHON=/usr/local/bin/python3.11
RUN test -x "${VENV_PYTHON}" || { echo "FATAL: ${VENV_PYTHON} not executable" >&2; exit 1; }
ENV VENV_PYTHON="${VENV_PYTHON}"

# Install runtime deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates gnupg \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js v22 from nodesource (for npx/node-based MCP servers)
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Install uv for uvx-based MCP servers
RUN curl -fsSL https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"

# Install pip dependencies
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir uvicorn fastapi

# Pre-cache existing npx packages (Phase 1 + Phase 2)
RUN npx -y -p mcp-server-fear-greed -c true 2>&1 | tail -1
RUN npx -y -p @anaisbetts/mcp-youtube -c true 2>&1 | tail -1
RUN npx -y -p wikipedia-mcp -c true 2>&1 | tail -1
RUN npx -y -p asset-price-mcp -c true 2>&1 | tail -1
RUN npx -y -p puremd-mcp -c true 2>&1 | tail -1
RUN npx -y -p @modelcontextprotocol/server-sequential-thinking -c true 2>&1 | tail -1
RUN npx -y -p think-tool-mcp -c true 2>&1 | tail -1
RUN npx -y -p @coinstats/coinstats-mcp -c true 2>&1 | tail -1
RUN npx -y -p @coolver/home-assistant-mcp -c true 2>&1 | tail -1
RUN npx -y -p @iflow-mcp/atom-of-thoughts -c true 2>&1 | tail -1
RUN npx -y -p @executeautomation/tmux-mcp-server -c true 2>&1 | tail -1
RUN npx -y -p @executeautomation/playwright-mcp-server -c true 2>&1 | tail -1
RUN npx -y -p @pipeworx/mcp-coinmarketcap -c true 2>&1 | tail -1

# Create stable symlinks for npx-cached packages (npx hashes change per build)
RUN set -e; \
    for pkg in "@coolver/home-assistant-mcp" "@iflow-mcp/atom-of-thoughts"; do \
        slug=$(echo "$pkg" | sed "s|@||;s|/|-|g"); \
        target_file=""; \
        for f in $(ls -d /root/.npm/_npx/*/node_modules/$pkg/build/index.js 2>/dev/null); do \
            target_file="$f"; break; \
        done; \
        if [ -n "$target_file" ]; then \
            ln -sf "$target_file" "/usr/local/bin/mcp-$slug"; \
            echo "Linked: mcp-$slug"; \
        else \
            echo "WARNING: $pkg not found in npx cache"; \
        fi; \
    done

# Install uv tools
RUN uv tool install mcpdoc 2>&1 | tail -2

# Perplexity: official @perplexity-ai/mcp-server (the community 'perplexity-mcp'
# has a stdout-flush bug — it ships each response one request late).
RUN npm install -g @perplexity-ai/mcp-server 2>&1 | tail -2

# Copy adapter code
COPY adapter.py logging_config.py /app/

# Declare port for runtime port-audit (must be >= 1024)
EXPOSE 8080

# Root-owned noexec trap: shells resolve to /dev/null when PATH-prepended
# for spawned MCP server environments only (prevents shell=True escalation).
RUN mkdir -p /usr/local/noexec \
    && chmod 0555 /usr/local/noexec \
    && ln -sf /dev/null /usr/local/noexec/sh \
    && ln -sf /dev/null /usr/local/noexec/bash \
    && ln -sf /dev/null /usr/local/noexec/python \
    && ln -sf /dev/null /usr/local/noexec/python3 \
    && ln -sf /dev/null /usr/local/noexec/dash \
    && ln -sf /dev/null /usr/local/noexec/ash

# Run as non-root: grant read access to root-owned caches (npx, uv)
RUN groupadd -r appuser && useradd -r -g appuser -d /home/appuser -m appuser \
    && chown -R appuser:appuser /app \
    && chmod -R a+rX /root/.npm /root/.local

USER appuser
ENV PATH="/usr/local/bin:/usr/bin:/bin:/root/.local/bin"
ENV HOME="/home/appuser"

HEALTHCHECK --interval=15s --timeout=5s --retries=3 \
    CMD curl -sf http://localhost:8080/health || exit 1

ENTRYPOINT ["/usr/local/bin/python3.11", "/app/adapter.py"]
CMD ["--port", "8080", "--host", "0.0.0.0", "--", "/usr/local/bin/npx", "-y", "mcp-server-fear-greed"]