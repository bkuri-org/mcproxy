#!/usr/bin/env sh
# --- BEGIN BEADS INTEGRATION v0.58.0 ---
# This section is managed by beads. Do not remove these markers.
if command -v bd >/dev/null 2>&1; then
  export BD_GIT_HOOK=1
  bd hooks run pre-push "$@"
  _bd_exit=$?; if [ $_bd_exit -ne 0 ]; then exit $_bd_exit; fi
fi
# --- END BEADS INTEGRATION ---

# Auto-deploy to server2 when pushing to main
# Checks if deployment is needed and schedules it to run after push completes

DEPLOY_NEEDED=0
REMOTE="$1"
URL="$2"

# Only deploy when pushing to origin
if [ "$REMOTE" = "origin" ]; then
    while read local_ref local_sha remote_ref remote_sha; do
        if [ "$remote_ref" = "refs/heads/main" ]; then
            CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
            if [ "$CURRENT_BRANCH" = "main" ]; then
                # Check if we have commits to push
                AHEAD=$(git rev-list --count origin/main..HEAD 2>/dev/null || echo "0")
                if [ "$AHEAD" -gt 0 ]; then
                    DEPLOY_NEEDED=1
                    echo ""
                    echo "📦 $AHEAD commit(s) to deploy after push completes..."
                    break
                fi
            fi
        fi
    done
fi

# Schedule deployment in background after push completes
if [ "$DEPLOY_NEEDED" = "1" ]; then
    (
        # Wait for push to complete (hook runs before push)
        sleep 3
        
        # Deploy to server2 — container build + Quadlet restart
        ssh server2-auto << 'DEPLOY_SCRIPT'
set -e
cd /srv/containers/mcproxy

# Ensure we're on main branch
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
if [ "$CURRENT_BRANCH" != "main" ]; then
    echo "  ⚠️  Switching from $CURRENT_BRANCH to main..."
    git checkout main
fi

echo ""
echo "🚀 Auto-deploying mcproxy container to server2..."
echo "  → Syncing to latest code..."
git fetch origin
git reset --hard origin/main
echo "  → Rebuilding container image..."
sudo podman build -t localhost/mcproxy:latest .
echo "  → Updating Quadlet unit..."
sudo cp mcproxy.container /etc/containers/systemd/mcproxy.container
echo "  → Reloading systemd..."
sudo systemctl daemon-reload
echo "  → Restarting mcproxy service (container)..."
sudo systemctl restart mcproxy.service
sleep 5
echo "  → Checking service status..."
if sudo systemctl is-active --quiet mcproxy.service; then
    echo "  ✓ mcproxy container is running"
    echo "  → Verifying health..."
    if curl -sf http://localhost:12010/health > /dev/null 2>&1; then
        echo "  ✓ Health check passed"
        echo ""
        echo "✅ Deployment complete!"
    else
        echo "  ✗ Container running but health check failed"
        sudo podman logs mcproxy 2>&1 | tail -10
        exit 1
    fi
else
    echo "  ✗ Container failed to start"
    sudo podman logs mcproxy 2>&1 | tail -20
    exit 1
fi
DEPLOY_SCRIPT
    ) &
    
    echo "⏳ Deployment scheduled (will run in background after push completes; wait ~45s before contacting)"
fi

exit 0
