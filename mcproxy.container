[Unit]
Description=MCProxy - MCP Gateway Aggregator (containerized)
Documentation=https://github.com/bkuri-org/mcproxy
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/mcproxy:latest
ContainerName=mcproxy

# Phase 1: host networking so container can reach bare-metal MCP servers on localhost
# Phase 3 (mcproxy-io1.3): switch to bridge + shared Podman network
Network=host

# Mount config (read-only), .env (read-only), data + cache (read-write)
Volume=/srv/containers/mcproxy/config:/app/config:ro,Z
Volume=/srv/containers/mcproxy/.env:/app/.env:ro,Z
Volume=mcproxy-data:/app/data:Z
Volume=mcproxy-cache:/app/cache:Z

# Environment
Environment=PYTHONUNBUFFERED=1

# Security hardening (Container-level)
NoNewPrivileges=true
SecurityLabelDisable=false
ReadOnly=true
CapDrop=ALL

# Resource limits
Memory=512M
MemorySwap=512M

# Labels
Label=app=mcproxy
Label=service=mcp
Label=phase=1-host-network

[Service]
Restart=always
RestartSec=10
TimeoutStartSec=120
TimeoutStopSec=60
ProtectHome=true
ProtectSystem=strict
PrivateTmp=true

[Install]
WantedBy=multi-user.target