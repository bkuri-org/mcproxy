[Unit]
Description=MCProxy MCP Gateway (Phase 3 - Bridge Network)
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/mcproxy:latest
ContainerName=mcproxy
Network=mcp-net
PublishPort=12010:12010
Exec=--log --port 12010 --host 0.0.0.0 --config /app/config/mcproxy.json

# Persistent volumes
Volume=/srv/containers/mcproxy/config/mcproxy.json:/app/config/mcproxy.json:ro,Z
Volume=/srv/containers/mcproxy/config/.env:/app/.env:ro,Z
Volume=mcproxy-data:/app/data:Z
Volume=mcproxy-cache:/app/cache:Z

# Security
ReadOnly=true
SecurityOpt=no-new-privileges
CapDrop=ALL

# Resources
Memory=512M
MemorySwap=512M

# Logging
LogDriver=k8s-file

# Environment
Environment=PYTHONUNBUFFERED=1

# Labels
Label=app=mcproxy
Label=phase=3-bridge

[Service]
Restart=always
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target default.target