[Unit]
Description=MCProxy MCP Gateway (Phase 3 - Bridge Network)
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/mcproxy:latest
ContainerName=mcproxy
Network=mcp-net
PublishPort=12010:12010
Exec=--log --port 12010 --host 0.0.0.0 --config /app/config/mcproxy.json

# Persistent volumes
Volume=/srv/containers/mcproxy/config/mcproxy.json:/app/config/mcproxy.json:ro,Z
Volume=/srv/containers/mcproxy/config/.env:/app/.env:ro,Z
Volume=mcproxy-data:/app/data:Z
Volume=mcproxy-cache:/app/cache:Z

# Security (Quadlet keys — NOT compose/docker-run names)
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL

# Logging
LogDriver=k8s-file

# Environment
Environment=PYTHONUNBUFFERED=1

# Labels
Label=app=mcproxy
Label=phase=3-bridge

[Service]
Restart=always
TimeoutStartSec=60
# Resource limits (Quadlet has no Memory= key; use systemd cgroup controls)
MemoryMax=512M
MemorySwapMax=512M

[Install]
WantedBy=multi-user.target default.target