[Unit]
Description=MCProxy - MCP Gateway Aggregator
Documentation=https://github.com/mcproxy/mcproxy
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/mcproxy:latest
ContainerName=mcproxy

# Network: lan-core for Caddy reverse proxy access + static IP
# NOTE: Update PodmanArgs --ip to an available IP on your lan-core subnet
Network=lan-core
PodmanArgs=--ip=10.90.0.20

# Expose on host IP so external clients (pi, 5ire, etc.) can connect
# NOTE: Change 192.168.50.X to match the deployment server's IP
PublishPort=192.168.50.X:12010:12010

# Mount config (read-only), data + cache (read-write)
Volume=/srv/containers/mcproxy/config:/app/config:ro,Z
Volume=/srv/containers/mcproxy/data:/app/data:rw,Z
Volume=/srv/containers/mcproxy/cache:/app/cache:rw,Z

# Environment
Environment=PYTHONUNBUFFERED=1

# Run with logging to stdout
Exec=python main.py --log --port 12010 --config /app/config/mcproxy.json

# Labels
Label=app=mcproxy
Label=service=gateway
Label=stack=core

# Security hardening
NoNewPrivileges=true
SecurityLabelDisable=false
ProtectHome=true
ProtectSystem=strict
PrivateTmp=true
ReadOnlyRootfs=true
CapDrop=ALL

# Resource limits
Memory=512M
MemorySwap=512M

[Service]
Restart=always
RestartSec=10
TimeoutStartSec=120
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target